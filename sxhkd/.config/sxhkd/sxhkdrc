#
# wm independent hotkeys
#
# version 0.6.3

# terminal emulator
super + Return
	st

# program launcher
super + d
	dmenu_run -p 'run this:'

# make sxhkd reload its configuration files:
super + Escape
	pkill -USR1 -x sxhkd; \
	notify-send --urgency=low --expire-time=5000 --app-name='sxhkd' 'sxhkd' 'Reloaded config'

# internet browsers
super + {_,shift + }i
	{librewolf,qutebrowser}

# screenshots
Print
	maim ~/Pictures/screenshots/$(date +%F_%H-%M-%S).png

#
# bspwm hotkeys
#

# media controls
XF86Audio{Lower,Raise}Volume
	wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05{-,+}

shift + XF86Audio{Lower,Raise}Volume
	wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.25{-,+}

{XF86AudioMute,XF86AudioMicMute}
	wpctl set-mute @DEFAULT_AUDIO_{SINK,SOURCE}@ toggle

# screen backlight brightness
XF86MonBrightness{Down,Up}
	brightnessctl --class=backlight set 5%{-,+}

# quit/restart bspwm
super + alt + q
	bspc quit

super + alt + r
	bspc wm -r; \
	notify-send --urgency=low --expire-time=5000 --app-name='sxhkd' 'bspwm' 'Reloaded configuration'

# close and kill
super + {_,shift + }w
	bspc node -{c,k}

# alternate between the tiled and monocle layout
super + m
	bspc desktop -l next

# send the newest marked node to the newest preselected node
super + y
	bspc node newest.marked.local -n newest.!automatic.local

# swap the current node and the biggest window
super + g
	bspc node -s biggest.window

#
# state/flags
#

# set the window state
super + {t,shift + t,s,f}
	bspc node -t {tiled,pseudo_tiled,floating,fullscreen}

# set the node flags
super + ctrl + {m,x,y,z}
	bspc node -g {marked,locked,sticky,private}

#
# focus/swap
#

# focus the node in the given direction
super + {_,shift +}{j,k,l,semicolon}
	bspc node -{f,s} {west,south,north,east}

# focus the node for the given path jump
super + shift + {p,b,comma,period}
	bspc node -f @{parent,brother,first,second}

# focus the next/previous window in the current desktop
super + {_,shift + }c
	bspc node -f {next,prev}.local.!hidden.window

# focus the next/previous desktop in the current monitor
super + {p,n}
	bspc desktop -f {prev,next}.local

# focus the last node/desktop
super + {_,shift} Tab
	bspc {node,desktop} -f last

# focus the older or newer node in the focus history
# super + {o,i}
# 	bspc wm -h off; \
# 	bspc node {older,newer} -f; \
# 	bspc wm -h on

# focus or send to the given desktop
super + {_,shift + }{1-9,0}
	bspc {desktop -f,node -d} '^{1-9,10}'

#
# preselect
#

# preselect the direction
super + ctrl + {j,k,l,semicolon}
	bspc node -p {west,south,north,east}

# preselect the ratio
super + ctrl + {1-9}
	bspc node -o 0.{1-9}

# cancel the preselection for the focused node
super + ctrl + g
	bspc node -p cancel

# cancel the preselection for the focused desktop
super + shift + ctrl + g
	bspc query -N -d | xargs -I id -n 1 bspc node id -p cancel

#
# move/resize
#
# reset the split ratios of all child nodes of the currently selected node
super + {r,b}
	bspc node --{equalize,balance}

# expand a window by moving one of its side outward
super + alt + {j,k,l,semicolon}
	bspc node -z {left -20 0,bottom 0 20,top 0 -20,right 20 0}

# contract a window by moving one of its side inward
super + ctrl + alt + {j,k,l,semicolon}
	bspc node -z {right -20 0,top 0 20,bottom 0 -20,left 20 0}

# move a floating window
super + shift + {Left,Down,Up,Right}
	bspc node -v {-20 0,0 20,0 -20,20 0}
